---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { listArtifacts, imageOf, fileOf, type Artifact } from '../../lib/artifacts';
import { coverToAscii } from '../../lib/ascii';
import SpinningSquare from '../../components/SpinningSquare.astro';

export async function getStaticPaths() {
  const list = await listArtifacts();
  return list.map((artifact, i) => ({
    params: { id: artifact.id },
    props: {
      artifact,
      position: i + 1,
      total: list.length,
      previous: list[(i - 1 + list.length) % list.length],
      next: list[(i + 1) % list.length],
    },
  }));
}

interface Props {
  artifact: Artifact;
  position: number;
  total: number;
  previous: Artifact;
  next: Artifact;
}

const { artifact, position, total, previous, next } = Astro.props;
const { id, data } = artifact;
const base = import.meta.env.BASE_URL;
const pad = (n: number) => String(n).padStart(3, '0');
const ascii = {
  lines: await coverToAscii(data.cover, { charset: data.charset, brightness: data.brightness }),
  seed: data.seed,
  accent: data.accent,
  charset: data.charset,
};
const has3d = data.blocks.some((b) => b.type === 'model3d');
---
<Base title={`${data.number} ${data.title} · artefatos`} accent={data.accent}>
  <header class="header">
    <span class="brand"><SpinningSquare href={base} /><a href={base}>guilty corisco // artefatos</a></span>
    <span>{pad(position)}/{pad(total)}</span>
  </header>

  <main class="artifact">
    <section class="cover">
      <canvas id="ascii" role="img" aria-label={`ASCII cover of ${data.title}`}></canvas>
      <dl class="sheet">
        <dt class="sr-only">number</dt><dd class="num">{data.number}</dd>
        <dt class="sr-only">title</dt><dd class="title">{data.title}<span class="cursor" aria-hidden="true"></span></dd>
        <dt class="sr-only">place and period</dt><dd>{[data.place, data.period].filter(Boolean).join(' · ')}</dd>
        <dt class="sr-only">media</dt><dd>{data.media.join(' / ')}</dd>
      </dl>
    </section>

    {data.blocks.map((b) => {
      if (b.type === 'photo' || b.type === 'scan') {
        return (
          <figure class:list={['block', b.type, { pixelated: b.type === 'photo' && b.pixelated }]}>
            <Picture
              src={imageOf(id, b.src)}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 720px, 100vw"
              quality={b.type === 'photo' ? 82 : 70}
              alt={b.caption ?? ''}
              loading="lazy"
            />
            {b.caption && <figcaption>{b.caption}</figcaption>}
          </figure>
        );
      }
      if (b.type === 'text') {
        return <p class="block text">{b.content}</p>;
      }
      if (b.type === 'audio') {
        return (
          <div class="block audio" data-audio>
            <audio src={fileOf(id, b.src)} preload="metadata" loop={b.loop}></audio>
            <button type="button" aria-label={`play ${b.title ?? 'audio'}`}>
              <span class="state">▶</span>
              <span class="track">{b.title ?? 'som'}</span>
              <span class="time">--:--</span>
            </button>
            <canvas class="meter" tabindex="0" aria-label="position, tap to seek"></canvas>
          </div>
        );
      }
      if (b.type === 'video') {
        return (
          <figure class="block video">
            <video
              src={fileOf(id, b.src)}
              poster={b.poster ? imageOf(id, b.poster).src : undefined}
              autoplay
              muted
              loop={b.loop}
              playsinline
              preload="metadata"
            ></video>
          </figure>
        );
      }
      if (b.type === 'model3d') {
        return (
          <figure class="block model">
            <model-viewer
              src={fileOf(id, b.src)}
              poster={b.poster ? imageOf(id, b.poster).src : undefined}
              camera-controls
              touch-action="pan-y"
              auto-rotate
              auto-rotate-delay="0"
              camera-orbit="-20deg 80deg auto"
              rotation-per-second="18deg"
              interaction-prompt="none"
              disable-zoom
              shadow-intensity="0"
              exposure="1"
              alt={b.caption ?? `3D object from ${data.title}`}
            ></model-viewer>
            {b.caption && <figcaption>{b.caption}</figcaption>}
          </figure>
        );
      }
      return null;
    })}
  </main>

  <nav class="pager">
    <a href={`${base}a/${previous.id}/`} data-special={previous.data.special}>← {previous.data.number}</a>
    <a href={base}>índice</a>
    <a href={`${base}a/${next.id}/`} data-special={next.data.special}>{next.data.number} →</a>
  </nav>

  <script type="application/json" id="data" set:html={JSON.stringify(ascii)} />
  {has3d && (
    <script
      is:inline
      type="module"
      src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"
    ></script>
  )}
  {has3d && (
    <script is:inline>
      // Spin starts on load, so reset it the first time each object comes
      // into view: the visitor always meets it from the front.
      const seen = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.resetTurntableRotation?.(0);
          seen.unobserve(e.target);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll('model-viewer').forEach((m) => seen.observe(m));
    </script>
  )}
</Base>

<style>
  .artifact {
    padding: calc(var(--header) + 8px) var(--gutter) 0;
    max-width: 720px;
    margin: 0 auto;
  }

  .cover canvas { display: block; width: 100%; aspect-ratio: 1; }

  .sheet {
    margin: 16px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--ink);
    text-transform: lowercase;
  }
  .sheet dd { margin: 0; }
  .sheet .num { color: var(--accent); }
  .sheet .title { text-transform: uppercase; }

  .block { margin: 18vh 0 0; }
  .block :global(img), .block video { display: block; width: 100%; height: auto; }
  .scan { background: #fff; padding: 12px; }
  .pixelated :global(img) { image-rendering: pixelated; }
  figcaption { margin-top: 6px; color: var(--grey); text-transform: lowercase; }

  .text { max-width: 42ch; text-transform: lowercase; white-space: pre-line; }

  .audio { border-top: 1px solid var(--ink); padding-top: 8px; }
  .audio button {
    all: unset;
    cursor: pointer;
    display: grid;
    grid-template-columns: 2ch 1fr auto;
    gap: 1ch;
    width: 100%;
    font: inherit;
    text-transform: lowercase;
  }
  .audio .state { color: var(--accent); }
  .audio .meter { display: block; width: 100%; height: 44px; margin-top: 10px; cursor: pointer; touch-action: none; }
  .audio button:focus-visible, .audio .meter:focus-visible { outline: 1px dashed var(--accent); outline-offset: 3px; }

  /* full-bleed: break out of the 720px column */
  .model { width: 100vw; margin-left: calc(50% - 50vw); }
  .model figcaption { padding: 0 var(--gutter); max-width: 720px; margin-inline: auto; }
  .model model-viewer {
    display: block;
    width: 100%;
    height: min(125vw, 86svh);
    background: transparent;
    --poster-color: transparent;
  }

  @media (min-width: 720px) {
    /* back to the text column so the page keeps scrolling around it */
    .model { width: 100%; margin-left: 0; }
    .model figcaption { padding: 0; }
    .model model-viewer { height: 90svh; }
  }

  .pager {
    display: flex;
    justify-content: space-between;
    padding: 18vh var(--gutter) calc(24px + env(safe-area-inset-bottom));
    max-width: 720px;
    margin: 0 auto;
  }
</style>

<script>
  import { AsciiCanvas } from '../../lib/ascii-canvas';
  import { FakeLevel } from '../../lib/fake-level';
  import { installEink } from '../../lib/eink';

  installEink();

  const canvas = document.getElementById('ascii') as HTMLCanvasElement;
  const data = JSON.parse(document.getElementById('data')!.textContent!);
  const ascii = new AsciiCanvas(canvas);
  const fit = () => ascii.resize(canvas.parentElement!.clientWidth);
  fit();
  ascii.reveal(data);
  window.addEventListener('resize', fit);

  // Audio player: one tap plays or pauses, one sound at a time.
  // Under each title, a row of ascii columns moves while the sound plays. It is
  // also the position: played columns in ink, the rest grey, the head in accent.
  // The playing sound shakes the cover and turns the header square.
  const COLUMNS = 40;
  const ROWS = 4;
  const STACK = ['.', ':', '=', '#'];
  const INK = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#111';
  const GREY = getComputedStyle(document.documentElement).getPropertyValue('--grey').trim() || '#a9a9a6';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fmt = (s: number) =>
    Number.isFinite(s) ? `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}` : '--:--';

  type Player = { audio: HTMLAudioElement; meter: HTMLCanvasElement; ctx: CanvasRenderingContext2D; level: FakeLevel };
  const players: Player[] = [...document.querySelectorAll<HTMLElement>('[data-audio]')].map((el, i) => {
    const audio = el.querySelector('audio')!;
    const state = el.querySelector('.state')!;
    const time = el.querySelector('.time')!;
    const meter = el.querySelector<HTMLCanvasElement>('.meter')!;
    audio.addEventListener('loadedmetadata', () => (time.textContent = fmt(audio.duration)));
    audio.addEventListener('timeupdate', () => {
      time.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
    });
    audio.addEventListener('play', () => (state.textContent = '■'));
    audio.addEventListener('pause', () => (state.textContent = '▶'));
    el.querySelector('button')!.addEventListener('click', () => {
      if (audio.paused) {
        players.forEach((p) => p.audio !== audio && p.audio.pause());
        audio.play();
      } else audio.pause();
    });

    const seek = (x: number) => {
      if (!audio.duration) return;
      const r = meter.getBoundingClientRect();
      audio.currentTime = Math.max(0, Math.min(0.999, (x - r.left) / r.width)) * audio.duration;
    };
    meter.addEventListener('pointerdown', (e) => {
      seek(e.clientX);
      meter.setPointerCapture(e.pointerId);
    });
    meter.addEventListener('pointermove', (e) => meter.hasPointerCapture(e.pointerId) && seek(e.clientX));
    meter.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      if (e.key === 'ArrowRight') audio.currentTime = Math.min(audio.duration - 0.1, audio.currentTime + 5);
      if (e.key === 'ArrowLeft') audio.currentTime = Math.max(0, audio.currentTime - 5);
    });

    return { audio, meter, ctx: meter.getContext('2d')!, level: new FakeLevel(COLUMNS, data.seed * 31 + i) };
  });

  const fitMeters = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    for (const p of players) {
      p.meter.width = Math.floor(p.meter.clientWidth * dpr);
      p.meter.height = Math.floor(p.meter.clientHeight * dpr);
      p.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
  };

  const drawMeter = (p: Player) => {
    const { ctx, meter, audio, level } = p;
    const w = meter.clientWidth;
    const h = meter.clientHeight;
    const cw = w / COLUMNS;
    const rh = h / ROWS;
    const head = audio.duration ? Math.floor((audio.currentTime / audio.duration) * COLUMNS) : -1;
    ctx.clearRect(0, 0, w, h);
    ctx.font = `bold ${Math.round(rh * 1.15)}px ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace`;
    ctx.textAlign = 'center';
    level.columns.forEach((c, i) => {
      const units = c.v * ROWS * STACK.length; // a quarter-row per glyph step
      ctx.fillStyle = i === head && level.energy > 0.05 ? data.accent : i < head ? INK : GREY;
      for (let r = 0; r < ROWS; r++) {
        const left = units - r * STACK.length;
        const ch = left >= STACK.length ? STACK[3] : left > 0 ? STACK[Math.ceil(left) - 1] : r === 0 ? '.' : '';
        if (ch) ctx.fillText(ch, i * cw + cw / 2, h - r * rh - rh * 0.12);
      }
    });
  };

  if (players.length) {
    fitMeters();
    window.addEventListener('resize', fitMeters);
    let last = performance.now();
    let lastCover = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      const t = now / 1000;
      let loudest: Player | null = null;
      for (const p of players) {
        p.level.update(t, dt, !p.audio.paused && !reduced);
        drawMeter(p);
        if (!loudest || p.level.energy > loudest.level.energy) loudest = p;
      }
      const l = loudest!;
      window.dispatchEvent(new CustomEvent('sound-energy', { detail: l.level.energy * (0.6 + l.level.average()) }));
      // the cover redraws in steps (~12 fps), like a terminal rather than a video
      if (now - lastCover > 83) {
        lastCover = now;
        const progress = l.audio.duration ? l.audio.currentTime / l.audio.duration : 0;
        ascii.breathe({ level: l.level, progress, t });
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
