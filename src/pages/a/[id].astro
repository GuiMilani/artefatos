---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { listArtifacts, chronology, imageOf, fileOf, type Artifact } from '../../lib/artifacts';
import { en } from '../../lib/i18n';
import { coverToAscii } from '../../lib/ascii';
import SpinningSquare from '../../components/SpinningSquare.astro';

export async function getStaticPaths() {
  const list = await listArtifacts();
  const order = chronology(list);
  return list.map((artifact, i) => ({
    params: { id: artifact.id },
    props: {
      artifact,
      position: order.get(artifact.id)!,
      total: list.length,
      previous: list[(i - 1 + list.length) % list.length],
      next: list[(i + 1) % list.length],
    },
  }));
}

interface Props {
  artifact: Artifact;
  position: number;
  total: number;
  previous: Artifact;
  next: Artifact;
}

const { artifact, position, total, previous, next } = Astro.props;
const { id, data } = artifact;
const base = import.meta.env.BASE_URL;
const pad = (n: number) => String(n).padStart(3, '0');
const ascii = {
  lines: await coverToAscii(data.cover, { charset: data.charset, brightness: data.brightness }),
  seed: data.seed,
  accent: data.accent,
  charset: data.charset,
};
const has3d = data.blocks.some((b) => b.type === 'model3d');
---
<Base title={`${data.number} ${data.title} · artefatos`} accent={data.accent} chao={data.chao}>
  <header class="header">
    <span class="brand"><SpinningSquare href={base} /><a href={base}>guilty corisco // artefatos</a></span>
    <span>{pad(position)}/{pad(total)}</span>
  </header>

  {data.blocks.some((b) => b.type === 'audio') && (
    <div class="mini" data-mini aria-hidden="true">
      <button type="button" class="mini-state" tabindex="-1">■</button>
      <button type="button" class="mini-track" tabindex="-1"></button>
      <canvas class="mini-meter"></canvas>
      <span class="mini-time">--:--</span>
    </div>
  )}

  <main class="artifact">
    <section class="cover">
      <canvas id="ascii" role="img" aria-label={`ASCII cover of ${data.title}`}></canvas>
      <dl class="sheet">
        <dt class="sr-only">number</dt><dd class="num">{data.number}</dd>
        <dt class="sr-only">title</dt><dd class="title">{data.title}<span class="cursor" aria-hidden="true"></span></dd>
        <dt class="sr-only">place and period</dt><dd>{[data.place, data.period].filter(Boolean).join(' · ')}</dd>
        <dt class="sr-only">media</dt><dd data-en={data.media.map(en).join(' / ')}>{data.media.join(' / ')}</dd>
      </dl>
    </section>

    {data.blocks.map((b) => {
      if (b.type === 'photo' || b.type === 'scan') {
        const img = imageOf(id, b.src);
        // On phones a wide scan is shown turned 90° so it fills the screen's height.
        const turn = b.type === 'scan' && (b.turn ?? img.width > img.height);
        const ratio = img.width / img.height;
        return (
          <figure
            class:list={['block', b.type, { pixelated: b.type === 'photo' && b.pixelated, turn }]}
            style={turn ? `--ratio:${ratio.toFixed(4)}` : undefined}
          >
            <div class="frame">
              <Picture
                src={img}
                formats={['avif', 'webp']}
                widths={turn ? [800, 1200, 1800, 2400] : [480, 800, 1200]}
                sizes={turn ? `(max-width: 719px) ${Math.ceil(ratio * 100)}vw, 720px` : '(min-width: 900px) 720px, 100vw'}
                quality={b.type === 'photo' ? 82 : 70}
                alt={b.caption ?? ''}
                loading="lazy"
              />
            </div>
            {b.caption && <figcaption data-en={en(b.caption)}>{b.caption}</figcaption>}
          </figure>
        );
      }
      if (b.type === 'text') {
        return <p class="block text">{b.content}</p>;
      }
      if (b.type === 'audio') {
        return (
          <div class="block audio" data-audio>
            <audio src={fileOf(id, b.src)} preload="metadata" loop={b.loop}></audio>
            <button type="button" aria-label={`play ${b.title ?? 'audio'}`}>
              <span class="state">▶</span>
              {b.title ? <span class="track">{b.title}</span> : <span class="track" data-en={en('som')}>som</span>}
              <span class="time">--:--</span>
            </button>
            <canvas class="meter" tabindex="0" aria-label="position, tap to seek"></canvas>
          </div>
        );
      }
      if (b.type === 'video') {
        return (
          <figure class="block video">
            <video
              src={fileOf(id, b.src)}
              poster={b.poster ? imageOf(id, b.poster).src : undefined}
              autoplay
              muted
              loop={b.loop}
              playsinline
              preload="metadata"
            ></video>
          </figure>
        );
      }
      if (b.type === 'model3d') {
        return (
          <figure class="block model">
            <model-viewer
              src={fileOf(id, b.src)}
              poster={b.poster ? imageOf(id, b.poster).src : undefined}
              camera-controls
              touch-action="pan-y"
              auto-rotate
              auto-rotate-delay="0"
              camera-orbit="-20deg 80deg auto"
              rotation-per-second="18deg"
              interaction-prompt="none"
              disable-zoom
              shadow-intensity="0"
              exposure="1"
              alt={b.caption ?? `3D object from ${data.title}`}
            ></model-viewer>
            {b.caption && <figcaption data-en={en(b.caption)}>{b.caption}</figcaption>}
          </figure>
        );
      }
      return null;
    })}
  </main>

  <nav class="pager">
    <a href={`${base}a/${previous.id}/`} data-special={previous.data.special}>← {previous.data.number}</a>
    <a href={base} data-en={en('índice')}>índice</a>
    <a href={`${base}a/${next.id}/`} data-special={next.data.special}>{next.data.number} →</a>
  </nav>

  <script type="application/json" id="data" set:html={JSON.stringify(ascii)} />
  {has3d && (
    <script
      is:inline
      type="module"
      src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"
    ></script>
  )}
  {has3d && (
    <script is:inline>
      // Spin starts on load, so reset it the first time each object comes
      // into view: the visitor always meets it from the front.
      const seen = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.resetTurntableRotation?.(0);
          seen.unobserve(e.target);
        }
      }, { threshold: 0.4 });
      document.querySelectorAll('model-viewer').forEach((m) => seen.observe(m));
    </script>
  )}
</Base>

<style>
  .artifact {
    padding: calc(var(--header) + 8px) var(--gutter) 0;
    max-width: 720px;
    margin: 0 auto;
  }

  .cover canvas { display: block; width: 100%; aspect-ratio: 1; }

  .sheet {
    margin: 16px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--ink);
    text-transform: lowercase;
  }
  .sheet dd { margin: 0; }
  .sheet .num { color: var(--accent); }
  .sheet .title { text-transform: uppercase; }

  .block { margin: 18vh 0 0; }
  .block :global(img), .block video { display: block; width: 100%; height: auto; }
  .scan { background: #fff; padding: 12px; }
  .pixelated :global(img) { image-rendering: pixelated; }

  /* phones: a wide scan turns 90° clockwise and takes the column's full width */
  @media (max-width: 719px) {
    .turn .frame { position: relative; aspect-ratio: 1 / var(--ratio); overflow: hidden; }
    .turn .frame :global(img) {
      position: absolute;
      top: 50%;
      left: 50%;
      width: calc(100% * var(--ratio));
      max-width: none;
      transform: translate(-50%, -50%) rotate(90deg);
    }
  }
  figcaption { margin-top: 6px; color: var(--grey); text-transform: lowercase; }

  .text { max-width: 42ch; text-transform: lowercase; white-space: pre-line; }

  .audio { border-top: 1px solid var(--ink); padding-top: 8px; }
  .audio button {
    all: unset;
    cursor: pointer;
    display: grid;
    grid-template-columns: 2ch 1fr auto;
    gap: 1ch;
    width: 100%;
    font: inherit;
    text-transform: lowercase;
  }
  .audio .state { color: var(--accent); }
  .audio .meter { display: block; width: 100%; height: 44px; margin-top: 10px; cursor: pointer; touch-action: none; }
  .audio button:focus-visible, .audio .meter:focus-visible { outline: 1px dashed var(--accent); outline-offset: 3px; }

  /* Compact player: one line under the header while a sound plays and its
     player has scrolled away. Scrolling back to the player hides it again. */
  .mini {
    position: fixed;
    top: var(--header);
    left: 0;
    right: 0;
    z-index: 9;
    height: 22px;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 2ch auto 1fr auto;
    align-items: center;
    gap: 1ch;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
    text-transform: lowercase;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.24s steps(3), transform 0.24s steps(3);
  }
  .mini.on { opacity: 1; transform: none; pointer-events: auto; }
  .mini button { all: unset; cursor: pointer; font: inherit; }
  .mini-state { color: var(--accent); }
  .mini-track { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 16ch; }
  .mini-meter { display: block; width: 100%; height: 14px; cursor: pointer; touch-action: none; }
  .mini-time { color: var(--grey); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .mini { transition: none; } }

  /* full-bleed: break out of the 720px column */
  .model { width: 100vw; margin-left: calc(50% - 50vw); }
  .model figcaption { padding: 0 var(--gutter); max-width: 720px; margin-inline: auto; }
  .model model-viewer {
    display: block;
    width: 100%;
    height: min(125vw, 86svh);
    background: transparent;
    --poster-color: transparent;
  }

  @media (min-width: 720px) {
    /* back to the text column so the page keeps scrolling around it */
    .model { width: 100%; margin-left: 0; }
    .model figcaption { padding: 0; }
    .model model-viewer { height: 90svh; }
  }

  .pager {
    display: flex;
    justify-content: space-between;
    padding: 18vh var(--gutter) calc(24px + env(safe-area-inset-bottom));
    max-width: 720px;
    margin: 0 auto;
  }
</style>

<script>
  import { AsciiCanvas } from '../../lib/ascii-canvas';
  import { FakeLevel } from '../../lib/fake-level';
  import { installEink } from '../../lib/eink';

  installEink();

  const canvas = document.getElementById('ascii') as HTMLCanvasElement;
  const data = JSON.parse(document.getElementById('data')!.textContent!);
  const ascii = new AsciiCanvas(canvas);
  const fit = () => ascii.resize(canvas.parentElement!.clientWidth);
  fit();
  ascii.reveal(data);
  window.addEventListener('resize', fit);

  // Audio player: one tap plays or pauses, one sound at a time.
  // Under each title, a row of ascii columns moves while the sound plays. It is
  // also the position: played columns in ink, the rest grey, the head in accent.
  // The playing sound shakes the cover and turns the header square.
  const COLUMNS = 40;
  const BAND_SWEEP_S = 22; // one pass of the band down the cover, as in the first prototype's clip
  const ROWS = 4;
  const STACK = ['.', ':', '=', '#'];
  const INK = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#111';
  const GREY = getComputedStyle(document.documentElement).getPropertyValue('--grey').trim() || '#a9a9a6';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const fmt = (s: number) =>
    Number.isFinite(s) ? `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}` : '--:--';

  type Player = {
    el: HTMLElement;
    title: string;
    audio: HTMLAudioElement;
    meter: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    level: FakeLevel;
  };
  let active: Player | null = null; // the last sound started, followed by the compact player
  const players: Player[] = [...document.querySelectorAll<HTMLElement>('[data-audio]')].map((el, i) => {
    const audio = el.querySelector('audio')!;
    const state = el.querySelector('.state')!;
    const time = el.querySelector('.time')!;
    const meter = el.querySelector<HTMLCanvasElement>('.meter')!;
    audio.addEventListener('loadedmetadata', () => (time.textContent = fmt(audio.duration)));
    audio.addEventListener('timeupdate', () => {
      time.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
    });
    audio.addEventListener('play', () => {
      state.textContent = '■';
      active = players[i];
    });
    audio.addEventListener('pause', () => (state.textContent = '▶'));
    el.querySelector('button')!.addEventListener('click', () => {
      if (audio.paused) {
        players.forEach((p) => p.audio !== audio && p.audio.pause());
        audio.play();
      } else audio.pause();
    });

    const seek = (x: number) => {
      if (!audio.duration) return;
      const r = meter.getBoundingClientRect();
      audio.currentTime = Math.max(0, Math.min(0.999, (x - r.left) / r.width)) * audio.duration;
    };
    meter.addEventListener('pointerdown', (e) => {
      seek(e.clientX);
      meter.setPointerCapture(e.pointerId);
    });
    meter.addEventListener('pointermove', (e) => meter.hasPointerCapture(e.pointerId) && seek(e.clientX));
    meter.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      if (e.key === 'ArrowRight') audio.currentTime = Math.min(audio.duration - 0.1, audio.currentTime + 5);
      if (e.key === 'ArrowLeft') audio.currentTime = Math.max(0, audio.currentTime - 5);
    });

    return {
      el,
      title: el.querySelector('.track')!.textContent ?? '',
      audio,
      meter,
      ctx: meter.getContext('2d')!,
      level: new FakeLevel(COLUMNS, data.seed * 31 + i),
    };
  });

  // Compact player under the header, mirroring whichever sound was started last.
  const mini = document.querySelector<HTMLElement>('[data-mini]');
  const miniState = mini?.querySelector('.mini-state') as HTMLElement | undefined;
  const miniTrack = mini?.querySelector('.mini-track') as HTMLElement | undefined;
  const miniTime = mini?.querySelector('.mini-time') as HTMLElement | undefined;
  const miniMeter = mini?.querySelector<HTMLCanvasElement>('.mini-meter');
  const miniCtx = miniMeter?.getContext('2d');
  // one glyph every ~8px, so the line stays as dense on a wide screen as on a phone
  const miniLevel = new FakeLevel(240, data.seed * 17 + 5);
  const miniColumns = () => Math.max(16, Math.min(240, Math.round((miniMeter?.clientWidth ?? 0) / 8)));
  const PAUSE_LINGER_MS = 2500; // after a pause the line waits a moment, then leaves
  let pausedAt = 0;
  let miniOn = false;
  if (mini && miniMeter) {
    miniState!.addEventListener('click', () => active && (active.audio.paused ? active.audio.play() : active.audio.pause()));
    miniTrack!.addEventListener('click', () => {
      if (!active) return;
      const y = active.el.getBoundingClientRect().top + window.scrollY - mini.offsetTop - 12;
      window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
    });
    const seekMini = (x: number) => {
      const a = active?.audio;
      if (!a || !a.duration) return;
      const r = miniMeter.getBoundingClientRect();
      a.currentTime = Math.max(0, Math.min(0.999, (x - r.left) / r.width)) * a.duration;
    };
    miniMeter.addEventListener('pointerdown', (e) => {
      seekMini(e.clientX);
      miniMeter.setPointerCapture(e.pointerId);
    });
    miniMeter.addEventListener('pointermove', (e) => miniMeter.hasPointerCapture(e.pointerId) && seekMini(e.clientX));
  }

  const updateMini = (now: number) => {
    if (!mini || !miniCtx || !miniMeter) return;
    const p = active;
    if (p && !p.audio.paused) pausedAt = 0;
    else if (p && !pausedAt) pausedAt = now;
    const away = !!p && p.el.getBoundingClientRect().bottom < mini.offsetTop + mini.offsetHeight;
    const on = away && (!p!.audio.paused || now - pausedAt < PAUSE_LINGER_MS);
    if (on !== miniOn) {
      miniOn = on;
      mini.classList.toggle('on', on);
      mini.setAttribute('aria-hidden', String(!on));
      mini.querySelectorAll('button').forEach((b) => (b.tabIndex = on ? 0 : -1));
    }
    if (!on || !p) return;
    const MINI_COLUMNS = miniColumns();
    miniState!.textContent = p.audio.paused ? '▶' : '■';
    if (miniTrack!.textContent !== p.title) miniTrack!.textContent = p.title;
    miniTime!.textContent = fmt(p.audio.currentTime);
    const w = miniMeter.clientWidth;
    const h = miniMeter.clientHeight;
    const cw = w / MINI_COLUMNS;
    const head = p.audio.duration ? Math.floor((p.audio.currentTime / p.audio.duration) * MINI_COLUMNS) : -1;
    miniCtx.clearRect(0, 0, w, h);
    miniCtx.font = `bold ${Math.round(h * 0.95)}px ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace`;
    miniCtx.textAlign = 'center';
    for (let i = 0; i < MINI_COLUMNS; i++) {
      // one row: each column shows how high its level stands, as a single glyph
      const v = miniLevel.columns[i].v;
      const ch = STACK[Math.min(STACK.length - 1, Math.floor(v * STACK.length))];
      miniCtx.fillStyle = i === head && p.level.energy > 0.05 ? data.accent : i < head ? INK : GREY;
      miniCtx.fillText(ch, i * cw + cw / 2, h * 0.78);
    }
  };

  const fitMeters = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    const canvases: [HTMLCanvasElement, CanvasRenderingContext2D][] = players.map((p) => [p.meter, p.ctx]);
    if (miniMeter && miniCtx) canvases.push([miniMeter, miniCtx]);
    for (const [c, ctx] of canvases) {
      c.width = Math.floor(c.clientWidth * dpr);
      c.height = Math.floor(c.clientHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
  };

  const drawMeter = (p: Player) => {
    const { ctx, meter, audio, level } = p;
    const w = meter.clientWidth;
    const h = meter.clientHeight;
    const cw = w / COLUMNS;
    const rh = h / ROWS;
    const head = audio.duration ? Math.floor((audio.currentTime / audio.duration) * COLUMNS) : -1;
    ctx.clearRect(0, 0, w, h);
    ctx.font = `bold ${Math.round(rh * 1.15)}px ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace`;
    ctx.textAlign = 'center';
    level.columns.forEach((c, i) => {
      const units = c.v * ROWS * STACK.length; // a quarter-row per glyph step
      ctx.fillStyle = i === head && level.energy > 0.05 ? data.accent : i < head ? INK : GREY;
      for (let r = 0; r < ROWS; r++) {
        const left = units - r * STACK.length;
        const ch = left >= STACK.length ? STACK[3] : left > 0 ? STACK[Math.ceil(left) - 1] : r === 0 ? '.' : '';
        if (ch) ctx.fillText(ch, i * cw + cw / 2, h - r * rh - rh * 0.12);
      }
    });
  };

  if (players.length) {
    fitMeters();
    window.addEventListener('resize', fitMeters);
    let last = performance.now();
    let lastCover = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      const t = now / 1000;
      let loudest: Player | null = null;
      for (const p of players) {
        p.level.update(t, dt, !p.audio.paused && !reduced);
        drawMeter(p);
        if (!loudest || p.level.energy > loudest.level.energy) loudest = p;
      }
      miniLevel.update(t, dt, !!active && !active.audio.paused && !reduced);
      updateMini(now);
      const l = loudest!;
      window.dispatchEvent(new CustomEvent('sound-energy', { detail: l.level.energy * (0.6 + l.level.average()) }));
      // the cover redraws in steps (~12 fps), like a terminal rather than a video
      if (now - lastCover > 83) {
        lastCover = now;
        // the band crosses the cover at the same pace whatever the track's length
        const progress = (l.audio.currentTime / BAND_SWEEP_S) % 1;
        ascii.breathe({ level: l.level, progress, t });
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
