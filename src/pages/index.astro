---
import Base from '../layouts/Base.astro';
import { listArtifacts, chronology } from '../lib/artifacts';
import { en } from '../lib/i18n';
import { coverToAscii } from '../lib/ascii';
import SpinningSquare from '../components/SpinningSquare.astro';

// Oldest at the top, newest at the bottom: the page opens on the newest one,
// with the older ones above it as a hint that the list scrolls.
const list = (await listArtifacts()).reverse();
const base = import.meta.env.BASE_URL;
const total = list.length;
const order = chronology(list);
const LOOP_FROM = 8;
const copies = total >= LOOP_FROM ? 3 : 1;
const middle = Math.floor(copies / 2);

const items = await Promise.all(
  list.map(async ({ id, data }) => ({
    id,
    url: `${base}a/${id}/`,
    number: data.number,
    title: data.title,
    position: order.get(id)!,
    info: [data.place, data.period, data.media.join('/')].filter(Boolean).join(' · '),
    infoEn: [data.place, data.period, data.media.map(en).join('/')].filter(Boolean).join(' · '),
    accent: data.accent,
    seed: data.seed,
    special: data.special,
    lines: await coverToAscii(data.cover, { charset: data.charset, brightness: data.brightness }),
  })),
);
const pad = (n: number) => String(n).padStart(3, '0');
---
<Base title="artefatos">
  <header class="header">
    <span class="brand"><SpinningSquare href={base} /><span>guilty corisco // artefatos</span></span>
    <span id="counter" aria-live="polite">{pad(total)}/{pad(total)}</span>
  </header>

  <div class="stage" id="stage">
    <canvas id="ascii" role="img" aria-label="ASCII cover of the focused artifact"></canvas>
  </div>

  <main>
    <ol class="index" id="index" data-copies={copies} data-total={total}>
      {Array.from({ length: copies }).flatMap((_, c) =>
        list.map(({ id, data }, i) => (
          <li class="item" data-i={i} aria-hidden={c !== middle ? 'true' : undefined}>
            <a href={`${base}a/${id}/`} data-special={data.special} tabindex={c !== middle ? -1 : undefined}>
              <span class="num">{data.number}</span>
              <span class="name"><span class="title" data-title={data.title}>{data.title}</span><span class="cursor" aria-hidden="true"></span></span>
              <span class="year">{data.year}</span>
            </a>
          </li>
        )),
      )}
    </ol>
  </main>

  <footer class="footer">
    <span id="info"></span>
  </footer>

  <script type="application/json" id="data" set:html={JSON.stringify(items)} />
</Base>

<style>
  :root {
    --item: 26px;
    --line: calc(var(--header) + 12vh); /* the reading line */
  }

  :global(html) {
    scroll-snap-type: y proximity;
  }

  .stage {
    position: fixed;
    top: calc(var(--line) + var(--item));
    bottom: var(--footer);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    z-index: 0;
  }

  canvas { display: block; cursor: pointer; }

  .index {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: var(--line) var(--gutter) calc(100svh - var(--line) - var(--item));
    pointer-events: none; /* lets taps between rows reach the canvas */
  }

  .item {
    height: var(--item);
    border-top: 1px solid var(--grey-light);
    color: var(--grey);
    scroll-snap-align: start;
    scroll-margin-top: var(--line);
    transition: color 0.15s linear;
  }

  .item a {
    pointer-events: auto;
    display: grid;
    grid-template-columns: 3.5ch 1fr auto;
    gap: 1ch;
    align-items: center;
    height: 100%;
  }

  .name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-transform: lowercase; }
  .item .cursor { display: none; }
  .item .cursor.typing { animation: none; } /* solid while typing, blinks once idle, like a terminal */

  .item.active { color: var(--ink); border-top-color: var(--ink); }
  .item.active .num { color: var(--accent); }
  .item.active .name { text-transform: uppercase; }
  .item.active .cursor { display: inline-block; }

  .footer {
    position: fixed;
    inset: auto 0 0 0;
    height: var(--footer);
    padding: 0 var(--gutter) env(safe-area-inset-bottom);
    display: flex;
    align-items: center;
    background: var(--paper);
    color: var(--ink);
    text-transform: lowercase;
    white-space: nowrap;
    overflow: hidden;
    z-index: 10;
  }

  @media (min-width: 900px) {
    :root { --line: calc(var(--header) + 18vh); }
    .index { max-width: 560px; }
    .stage { left: 600px; top: var(--header); justify-content: flex-start; align-items: center; }
  }
</style>

<script>
  import { AsciiCanvas, type AsciiData } from '../lib/ascii-canvas';
  import { typewrite } from '../lib/typewriter';
  import { einkTo, installEink } from '../lib/eink';
  import { flashTo } from '../lib/flash';

  type Item = AsciiData & { id: string; url: string; number: string; title: string; position: number; info: string; infoEn: string; special?: string };

  const items: Item[] = JSON.parse(document.getElementById('data')!.textContent!);
  const index = document.getElementById('index')!;
  const stage = document.getElementById('stage')!;
  const canvas = document.getElementById('ascii') as HTMLCanvasElement;
  const counter = document.getElementById('counter')!;
  const info = document.getElementById('info')!;
  const rows = [...index.querySelectorAll<HTMLLIElement>('.item')];
  const total = items.length;
  const copies = Number(index.dataset.copies);
  const ascii = new AsciiCanvas(canvas);
  const pad = (n: number) => String(n).padStart(3, '0');
  const english = document.documentElement.lang === 'en';

  const rowHeight = () => rows[0]?.getBoundingClientRect().height || 26;
  const loopBlock = () => total * rowHeight();

  let active = -1;
  let typed: HTMLElement | null = null;

  // The focused name types itself in like the line below it; the one it
  // leaves gets its whole name back at once.
  function typeName(row: HTMLLIElement) {
    const el = row.querySelector<HTMLElement>('.title')!;
    if (typed === el) return;
    if (typed) typewrite(typed, typed.dataset.title!, 0);
    typed = el;
    const cursor = row.querySelector<HTMLElement>('.cursor')!;
    const text = el.dataset.title!;
    cursor.classList.add('typing');
    typewrite(el, text, 45, () => cursor.classList.remove('typing'));
  }

  function rawPosition() {
    return Math.round(window.scrollY / rowHeight());
  }

  function activate(k: number) {
    const i = ((k % total) + total) % total;
    rows.forEach((el, n) => el.classList.toggle('active', n === k));
    if (rows[k]) typeName(rows[k]);
    if (i === active) return;
    active = i;
    const d = items[i];
    document.body.style.setProperty('--accent', d.accent);
    counter.textContent = `${pad(d.position)}/${pad(total)}`;
    ascii.reveal(d);
    typewrite(info, english ? d.infoEn : d.info);
  }

  // Infinite loop: the list is rendered three times and the scroll position
  // jumps by one whole block near either end, with no visible change.
  function keepCentred() {
    if (copies < 3) return;
    const b = loopBlock();
    const jump = window.scrollY < b * 0.5 ? b : window.scrollY > b * 1.5 ? -b : 0;
    if (!jump) return;
    window.dispatchEvent(new CustomEvent('scroll-jump', { detail: jump }));
    window.scrollTo(0, window.scrollY + jump);
  }

  let scheduled = false;
  function onScroll() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => {
      scheduled = false;
      keepCentred();
      activate(rawPosition());
    });
  }

  function fit() {
    const r = stage.getBoundingClientRect();
    ascii.resize(Math.min(r.width, r.height));
  }

  // Tapping an inactive row brings it to the reading line; tapping the active one opens it.
  index.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest('.item') as HTMLLIElement | null;
    if (!li || li.classList.contains('active')) return;
    e.preventDefault();
    window.scrollTo({ top: rows.indexOf(li) * rowHeight(), behavior: 'smooth' });
  });
  canvas.addEventListener('click', () => {
    if (active < 0) return;
    const d = items[active];
    if (d.special) einkTo(d.url, d.special);
    else flashTo(d.url);
  });
  installEink();

  // Every 8 seconds without a touch, the focus moves on to another artifact, at random.
  const CYCLE_MS = 8000;
  const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cycle = 0;
  function restartCycle() {
    clearInterval(cycle);
    cycle = window.setInterval(() => {
      if (document.hidden || total < 2 || active < 0) return;
      let next = Math.floor(Math.random() * (total - 1));
      if (next >= active) next++;
      const k = rawPosition() - active + next; // same copy of the list
      window.scrollTo({ top: k * rowHeight(), behavior: smooth ? 'smooth' : 'auto' });
    }, CYCLE_MS);
  }
  for (const type of ['wheel', 'touchstart', 'pointerdown', 'keydown']) {
    window.addEventListener(type, restartCycle, { passive: true });
  }
  restartCycle();

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => { fit(); onScroll(); });

  // Open on the newest artifact, the last row (of the middle copy when looping).
  fit();
  const start = (copies >= 3 ? loopBlock() : 0) + (total - 1) * rowHeight();
  window.dispatchEvent(new CustomEvent('scroll-jump', { detail: start }));
  window.scrollTo(0, start);
  activate(rawPosition());
</script>
