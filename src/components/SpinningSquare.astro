---
// The square from the professional portfolio (guimilani.github.io): an outlined
// square in the navigation bar that rotates as the page scrolls.
// The original uses GSAP ScrollTrigger (5 full turns over 10,000px, scrub 0.2);
// this reproduces the same mapping and easing without the dependency.
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'artefatos' } = Astro.props;
---
<a class="square-link" href={href} aria-label={label}>
  <svg class="square" id="spinning-square" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <rect x="1.5" y="1.5" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2.2" />
  </svg>
</a>

<style>
  .square-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-left: -4px;
  }
  .square {
    display: block;
    will-change: transform;
  }
</style>

<script>
  const DEGREES_PER_PX = (360 * 5) / 10000; // same as the professional site
  const SCRUB_SECONDS = 0.2;

  const square = document.getElementById('spinning-square');
  if (square) {
    let lastY = window.scrollY;
    let travelled = 0; // signed distance scrolled since load, ignoring loop jumps
    let shown = 0;
    let lastT = performance.now();

    // The index page's infinite loop jumps the scroll position by a whole block;
    // it announces the jump so the square doesn't spin with it.
    window.addEventListener('scroll-jump', (e) => {
      lastY += (e as CustomEvent<number>).detail;
    });

    const frame = (t: number) => {
      const y = window.scrollY;
      travelled += y - lastY;
      lastY = y;
      const dt = Math.min(0.1, (t - lastT) / 1000);
      lastT = t;
      // Exponential catch-up, roughly what GSAP's scrub does.
      shown += (travelled - shown) * (1 - Math.exp(-dt / (SCRUB_SECONDS / 3)));
      square.style.transform = `rotate(${(shown * DEGREES_PER_PX).toFixed(2)}deg)`;
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
