---
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao?: string;
  acento?: string;
}
const { titulo, descricao = 'artefatos: ciclos de produção de Guilherme Milani', acento } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#f6f6f4" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{titulo}</title>
  </head>
  <body style={acento ? `--acento:${acento}` : undefined}>
    <slot />
  </body>
</html>
