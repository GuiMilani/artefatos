---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  accent?: string;
}
const { title, description = 'guilty corisco · artefatos', accent } = Astro.props;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f6f4" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content="artefatos" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <slot />
    <script is:inline>
      // Labels follow the device language: Portuguese stays as written,
      // any other language gets the English in data-en.
      (() => {
        const lang = (navigator.languages && navigator.languages[0]) || navigator.language || 'pt';
        if (/^pt\b/i.test(lang)) return;
        document.documentElement.lang = 'en';
        document.querySelectorAll('[data-en]').forEach((el) => (el.textContent = el.dataset.en));
      })();
    </script>
  </body>
</html>
