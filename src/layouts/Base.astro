---
import '../styles/global.css';
import ChaoColumn from '../components/ChaoColumn.astro';

interface Props {
  title: string;
  description?: string;
  accent?: string;
  /** Show the drifting chao column on the right edge. */
  chao?: boolean;
}
const { title, description = 'guilty corisco · artefatos', accent, chao = false } = Astro.props;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f6f4" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content="artefatos" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Arriving through the e-ink transition (src/lib/eink.ts): the page opens
      // under the last e-ink image (global.css), which then dissolves pixel by
      // pixel (einkArrive below).
      try {
        const arrival = JSON.parse(sessionStorage.getItem('eink-arrival') || 'null');
        sessionStorage.removeItem('eink-arrival');
        if (arrival) {
          const html = document.documentElement;
          html.style.setProperty('--eink-src', `url("${arrival.src}")`);
          html.style.setProperty('--eink-size', `${arrival.w}px ${arrival.h}px`);
          html.classList.add('eink-arrival');
          window.__einkArrival = arrival;
        }
      } catch (e) {}
      // Arriving through the plain page flash (src/lib/flash.ts), or through
      // the browser's back/forward buttons or a refresh: open in negative (global.css)
      // and snap back a beat after the first paint.
      window.__flashIn = () => {
        const html = document.documentElement;
        if (html.classList.contains('eink-arrival')) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        html.classList.add('flash-arrival');
        requestAnimationFrame(() => requestAnimationFrame(() =>
          setTimeout(() => html.classList.remove('flash-arrival'), 70)));
      };
      try {
        const nav = performance.getEntriesByType('navigation')[0];
        const flagged = sessionStorage.getItem('flash-arrival');
        sessionStorage.removeItem('flash-arrival');
        if (flagged || (nav && (nav.type === 'back_forward' || nav.type === 'reload'))) window.__flashIn();
      } catch (e) {}
    </script>
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    {chao && <ChaoColumn />}
    <slot />
    <script is:inline>
      // Labels follow the device language: Portuguese stays as written,
      // any other language gets the English in data-en.
      (() => {
        const lang = (navigator.languages && navigator.languages[0]) || navigator.language || 'pt';
        if (/^pt\b/i.test(lang)) return;
        document.documentElement.lang = 'en';
        document.querySelectorAll('[data-en]').forEach((el) => (el.textContent = el.dataset.en));
      })();
    </script>
    <script>
      import { einkArrive } from '../lib/eink';
      import { installFlash } from '../lib/flash';
      einkArrive();
      installFlash();
    </script>
  </body>
</html>
