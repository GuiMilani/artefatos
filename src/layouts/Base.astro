---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  accent?: string;
}
const { title, description = 'guilty corisco · artefatos', accent } = Astro.props;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f6f4" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content="artefatos" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Arriving through the e-ink transition (src/lib/eink.ts): the page opens
      // under the last e-ink image, which then fades off (global.css).
      try {
        const arrival = JSON.parse(sessionStorage.getItem('eink-arrival') || 'null');
        sessionStorage.removeItem('eink-arrival');
        if (arrival) {
          const html = document.documentElement;
          html.style.setProperty('--eink-src', `url("${arrival.src}")`);
          html.style.setProperty('--eink-size', `${arrival.w}px ${arrival.h}px`);
          html.classList.add('eink-arrival');
        }
      } catch (e) {}
    </script>
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <slot />
  </body>
</html>
